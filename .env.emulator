# ローカルの Firebase Emulator 用（npm run emulators と npm run dev:emulator）
# demo- で始まるプロジェクトIDは本番の Firebase に接続しない
VITE_USE_FIREBASE_EMULATOR=true
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-quickmemo.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-quickmemo
VITE_FIREBASE_STORAGE_BUCKET=demo-quickmemo.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
